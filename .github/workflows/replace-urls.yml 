name: Replace Package Name (Full)

on:
  workflow_dispatch:  # 允许手动触发
  push:
    branches: [ cmod_bionic ]  # 指定分支

jobs:
  replace-package-name:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        ref: cmod_bionic  # 指定分支
        fetch-depth: 0

    - name: Replace in Java/Kotlin/XML/Gradle
      run: |
        # 替换 Java/Kotlin 文件中的包名声明
        find . -type f \( -name "*.java" -o -name "*.kt" \) \
          -exec sed -i 's/package com\.winlator\.cmod/package com.ludashi.benchmark/g' {} +
        
        # 替换 XML 文件中的包名（AndroidManifest.xml、布局文件等）
        find . -type f -name "*.xml" \
          -exec sed -i 's/com\.winlator\.cmod/com.ludashi.benchmark/g' {} +
        
        # 替换 Gradle 文件中的 applicationId
        find . -type f -name "*.gradle" \
          -exec sed -i 's/com\.winlator\.cmod/com.ludashi.benchmark/g' {} +

    - name: Replace in Native Code (C/C++)
      run: |
        # 替换 JNI 函数名中的包名（com_winlator_cmod → com_ludashi_benchmark）
        find . -type f \( -name "*.c" -o -name "*.cpp" -o -name "*.h" \) \
          -exec sed -i 's/com_winlator_cmod/com_ludashi_benchmark/g' {} +
        
        # 替换硬编码的包名字符串
        find . -type f \( -name "*.c" -o -name "*.cpp" -o -name "*.h" \) \
          -exec sed -i 's/"com\.winlator\.cmod"/"com.ludashi.benchmark"/g' {} +

    - name: Commit changes
      run: |
        git config --global user.name "GitHub Actions"
        git config --global user.email "actions@github.com"
        git add .
        git commit -m "Replace package name: com.winlator.cmod → com.ludashi.benchmark" || echo "No changes to commit"
        git push
